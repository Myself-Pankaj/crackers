VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=your-web-app-id

# Optional: change only if you created a named Firestore database.
VITE_FIREBASE_DATABASE_ID=(default)

# Server-only Cloudinary credentials. Never prefix the secret with VITE_.
CLOUDINARY_CLOUD_NAME=buymybook
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Use fixed only for a legacy fixed-folder Cloudinary environment.
CLOUDINARY_FOLDER_MODE=dynamic

# Optional: public deployed website origin for mobile bill links. No trailing path.
# PUBLIC_SITE_URL=https://your-store.netlify.app

# Short.io: secret API key (server only) and the hostname from your account.
SHORT_IO_API_KEY=
# Public domain, without https:// or a path; required for both builds and functions.
VITE_SHORT_IO_DOMAIN=
